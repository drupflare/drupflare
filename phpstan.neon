parameters:
    level: 5
    paths:
        - src
    treatPhpDocTypesAsCertain: false
    scanFiles:
        # stubs/ declares the RUNTIME's own symbols: vrzno_* from the extension, pw_* from the
        # php-wasm build. Nothing else declares them anywhere.
        - stubs/vrzno.php
        # Drupal's procedural functions are NOT autoloadable -- classes resolve through composer,
        # but drupal_static_reset() and friends live in include files that only a booted kernel
        # requires, so phpstan never sees them. These are the real definitions from the real
        # dependency, which is why they are scanned rather than stubbed: a stub would carry a
        # signature that can drift from core's.
        - vendor/drupal/core/includes/bootstrap.inc
        - vendor/drupal/core/includes/common.inc
        # A MODULE's namespace is registered by the kernel at runtime, not by composer, so
        # Drupal\user\ resolves at execution and is invisible to phpstan. Same reason as the include
        # files above: the real definitions from the real dependency rather than a stub that drifts.
        - vendor/drupal/core/modules/user/src/Entity/Role.php
        - vendor/drupal/core/modules/user/src/Entity/User.php
